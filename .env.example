# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_SETTINGS_MODULE=engram.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=engram
POSTGRES_USER=engram
POSTGRES_PASSWORD=engram_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Ollama (primary embedding provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Ollama chat model (for intelligence layer enrichment)
OLLAMA_CHAT_MODEL=llama3.2:3b

# Auto-enrich memories on create (set to true to enable)
AUTO_ENRICH_ON_CREATE=

# OpenRouter (fallback embedding provider)
OPENROUTER_API_KEY=
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# MCP Server (leave empty for open access in dev)
MCP_API_KEY=

# REST API (leave empty for open access in dev)
REST_API_KEY=

# Ingestion
INGEST_CHUNK_SIZE=2000
INGEST_CHUNK_OVERLAP=200
INGEST_MAX_FILE_SIZE=10485760

# Production (override for production deployment)
# DJANGO_SETTINGS_MODULE=engram.settings.production
# POSTGRES_PASSWORD=<strong-random-password>
# MCP_API_KEY=<generated-api-key>
# REST_API_KEY=<generated-api-key>
# CONN_MAX_AGE=600

# CORS (production only, comma-separated origins)
CORS_ALLOWED_ORIGINS=https://localhost:5173
